{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/salsburygroup/salsbury-md-analysis/schemas/analysis-lock.schema.json",
  "title": "Publication or Project Analysis Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "suite_commit",
    "project_commit",
    "profile_id",
    "environment_identity",
    "input_manifest_sha256",
    "source_manifest_sha256",
    "owner",
    "technical_status",
    "scientific_status"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "suite_repository": {"type": "string"},
    "suite_version": {"type": "string"},
    "suite_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "project_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "environment_identity": {"type": "string", "minLength": 1},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "output_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "authoritative_data_roots": {"type": "array", "items": {"type": "string"}},
    "external_dependencies": {"type": "array", "items": {"type": "object"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "random_seeds": {"type": "array", "items": {"type": ["integer", "string"]}},
    "owner": {"type": "string", "minLength": 1},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "technical_status": {"enum": ["complete", "failed", "blocked", "skipped", "withdrawn"]},
    "scientific_status": {"type": "string", "minLength": 1},
    "frame_budget_sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "status"],
      "properties": {
        "policy": {"enum": ["off", "recommend", "require"]},
        "status": {"enum": ["completed", "skipped", "unavailable", "not_applicable", "planned"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_report_sha256": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "replica_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "status"],
      "properties": {
        "policy": {"enum": ["off", "optional"]},
        "status": {"enum": ["completed", "skipped", "unavailable", "not_applicable", "planned"]},
        "rationale": {"type": "string", "minLength": 1},
        "additional_replicas_may_be_useful": {"type": ["boolean", "null"]},
        "evidence_report_sha256": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  }
}
