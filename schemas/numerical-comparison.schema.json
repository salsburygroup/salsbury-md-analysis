{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_file",
    "candidate_file",
    "comparisons"
  ],
  "properties": {
    "reference_file": {
      "type": "string",
      "minLength": 1
    },
    "candidate_file": {
      "type": "string",
      "minLength": 1
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observable_id",
          "statistic",
          "tolerance"
        ],
        "properties": {
          "observable_id": {
            "type": "string",
            "minLength": 1
          },
          "statistic": {
            "enum": [
              "mean",
              "distribution",
              "conditioning_fraction",
              "lagged_correlation",
              "switch_probability"
            ]
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "lag_frames": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "bootstrap_repeats": {
      "type": "integer",
      "minimum": 20,
      "maximum": 10000
    },
    "block_length_frames": {
      "type": "integer",
      "minimum": 2
    },
    "confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Numerical Protocol Comparison"
}
