{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_provenance",
    "weighting",
    "observables",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "observable_timeseries_v1"
    },
    "source_provenance": {
      "type": "object",
      "required": [
        "description",
        "sha256"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "weighting": {
      "enum": [
        "frame",
        "replica_equal"
      ]
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observable_id",
          "unit",
          "definition",
          "kind",
          "histogram_edges"
        ],
        "properties": {
          "observable_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "scalar",
              "indicator"
            ]
          },
          "histogram_edges": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "condition_observable_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_id",
          "replica_id",
          "segment_id",
          "frame_interval",
          "time_unit",
          "source_frame_stride",
          "rows"
        ],
        "properties": {
          "system_id": {
            "type": "string",
            "minLength": 1
          },
          "replica_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "frame_interval": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "time_unit": {
            "enum": [
              "fs",
              "ps",
              "ns",
              "us"
            ]
          },
          "source_frame_stride": {
            "type": "integer",
            "minimum": 1
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_frame_index",
                "time",
                "values"
              ],
              "properties": {
                "source_frame_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "time": {
                  "type": "number"
                },
                "values": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "simulation_protocol": {
            "additionalProperties": false,
            "properties": {
              "constraints": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "parameters": {
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "parameters"
                ],
                "type": "object"
              },
              "ensemble": {
                "minLength": 1,
                "type": "string"
              },
              "hamiltonian_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "initial_ensemble_id": {
                "minLength": 1,
                "type": "string"
              },
              "integration_step_fs": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "integrator": {
                "minLength": 1,
                "type": "string"
              },
              "protocol_id": {
                "minLength": 1,
                "type": "string"
              },
              "temperature_kelvin": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "thermostat": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "parameters": {
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "parameters"
                ],
                "type": "object"
              }
            },
            "required": [
              "protocol_id",
              "integration_step_fs",
              "integrator",
              "thermostat",
              "constraints",
              "hamiltonian_sha256",
              "ensemble",
              "temperature_kelvin",
              "initial_ensemble_id"
            ],
            "type": "object"
          }
        }
      }
    },
    "joint_observables": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observable Timeseries Input"
}
