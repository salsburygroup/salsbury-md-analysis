{
  "config_schema": "salsbury-analysis-config-v1",
  "default_module_policy": "all_applicable",
  "modules": {
    "energetic_network_embeddings": {
      "enabled": true,
      "options": {}
    }
  },
  "views": {
    "global_common_heavy": {
      "enabled": false,
      "state_trajectory_exports_enabled": false
    },
    "macromolecular_trace": {
      "enabled": true,
      "state_trajectory_exports_enabled": false
    }
  },
  "execution": {
    "submission_adapter": "local",
    "maximum_parallel_cpus": 2,
    "maximum_hours_per_cpu": 1.0,
    "maximum_memory_gib": 32.0,
    "maximum_scratch_gib": 8.0,
    "planning_utilization": 0.85,
    "pilot_budget_fraction": 0.05,
    "finalization_headroom_fraction": 0.05,
    "time_safety_factor": 1.5,
    "memory_safety_factor": 1.25,
    "censored_timeout_safety_factor": 1.5,
    "fail_if_minimum_coverage_unaffordable": true,
    "coordinate_cache": "off"
  }
}
